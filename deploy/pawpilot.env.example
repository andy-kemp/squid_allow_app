# /etc/pawpilot/pawpilot.env - PAW Proxy Pilot settings (owner root:pawpilot, mode 640)
# The installer writes this for you. Restart after editing:
#   sudo systemctl restart pawpilot

# --- Web --------------------------------------------------------------------
# Full URL you browse to. Must match the redirect URI in the Entra app registration.
PAWPILOT_BASE_URL=https://pawproxy.example.com:8443
PAWPILOT_LISTEN=0.0.0.0
PAWPILOT_PORT=8443
PAWPILOT_TLS_CERT=/etc/pawpilot/tls/pawpilot.crt
PAWPILOT_TLS_KEY=/etc/pawpilot/tls/pawpilot.key
# Long random string; generated by the installer. The app won't start without it.
PAWPILOT_SESSION_SECRET=
PAWPILOT_SESSION_HOURS=8

# --- Entra ID sign-in -------------------------------------------------------
PAWPILOT_ENTRA_TENANT_ID=
PAWPILOT_ENTRA_CLIENT_ID=
PAWPILOT_ENTRA_CLIENT_SECRET=
# YYYY-MM-DD. PAW Proxy Pilot warns 30 days before. Set by install.sh --entra.
PAWPILOT_ENTRA_SECRET_EXPIRES=
# Use an app role (recommended), an allow-list, or both. At least one is required.
PAWPILOT_REQUIRED_ROLE=PAWProxyPilot.Admin
PAWPILOT_ALLOWED_USERS=

# --- Squid ------------------------------------------------------------------
# The apply helper always writes /etc/squid/allowed_paw.acl; keep this the same.
PAWPILOT_SQUID_ACL=/etc/squid/allowed_paw.acl
PAWPILOT_SQUID_LOG=/var/log/squid/access.log
PAWPILOT_SQUID_SERVICE=squid
PAWPILOT_APPLY_CMD=sudo -n /usr/local/sbin/pawpilot-apply
# Only the newest part of the access log is read, to keep pages fast.
PAWPILOT_LOG_MAX_MB=32
PAWPILOT_DATA_DIR=/var/lib/pawpilot
